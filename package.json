{
  "name": "gogoga-mindmap",
  "version": "0.3.0",
  "description": "XMind 风格的 Obsidian 思维导图：Markdown 与脑图双向互转，现代审美，零依赖。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "harness": "node esbuild.config.mjs harness",
    "install-vault": "node scripts/install-vault.mjs",
    "gen-bench": "node scripts/gen-bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
